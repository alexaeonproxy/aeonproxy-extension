{
  "manifest_version": 3,
  "name": "AeonProxy — Proxy Manager",
  "short_name": "AeonProxy",
  "version": "1.0.0",
  "description": "Connect your browser to AeonProxy residential, mobile, ISP and datacenter proxies in two clicks, or to any proxy of your own.",
  "homepage_url": "https://aeonproxy.com",
  "minimum_chrome_version": "116",
  "permissions": ["proxy", "storage", "webRequest", "webRequestAuthProvider", "browsingData", "privacy"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AeonProxy",
    "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png" }
  },
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    { "matches": ["https://aeonproxy.com/dashboard/extension*"], "js": ["connect.js"], "run_at": "document_idle" }
  ]
}
